<mxfile host="app.diagrams.net"><diagram id="pr-flow" name="pr-flow"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Pull Request の流れ — 出す・受ける・直す・マージする" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="800" height="30" as="geometry"/></mxCell><mxCell id="c2" value="① main から&lt;br&gt;ブランチを切る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="200" height="75" as="geometry"/></mxCell><mxCell id="c3" value="② 実装 +&lt;br&gt;&lt;b&gt;セルフレビュー&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;git diff を自分で読む&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="255" y="70" width="200" height="75" as="geometry"/></mxCell><mxCell id="c4" value="③ git push -u" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="200" height="75" as="geometry"/></mxCell><mxCell id="c5" value="④ PR 作成&lt;br&gt;&lt;font style='font-size:11px'&gt;What / Why / 動作確認&lt;br&gt;を全部埋める&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="725" y="70" width="200" height="75" as="geometry"/></mxCell><mxCell id="c6" value="⑤ レビュー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="200" height="75" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;指摘あり&lt;/b&gt; → 同じブランチに追いコミット → git push&lt;br&gt;&lt;font style='font-size:11px'&gt;push するだけで PR に自動反映。「修正しました(コミットID)」と返信&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="220" width="435" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Approve&lt;/b&gt;&lt;br&gt;マージ + ブランチ削除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="220" width="200" height="70" as="geometry"/></mxCell><mxCell id="c13" value="git switch main&lt;br&gt;→ git pull で最新化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="340" width="200" height="60" as="geometry"/></mxCell><mxCell id="c14" value="指摘" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="707" y="440"/><mxPoint x="1185" y="440"/><mxPoint x="1185" y="107"/></Array></mxGeometry></mxCell><mxCell id="c16" value="再レビュー" style="edgeLabel;html=1;align=center;fontSize=12;" vertex="1" connectable="0" parent="c15"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c17" value="OK" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;レビュアー側の型(3コメント)&lt;/b&gt;&lt;br&gt;1. 良い点を1つ具体的に&lt;br&gt;2. 質問を1つ(詰問ではなく理解のため)&lt;br&gt;3. 提案を1つ(理由を添えて)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="435" height="120" as="geometry"/></mxCell><mxCell id="c20" value="鉄則: PR は1機能1本・小さく(目安300行以内)。タイトルと本文だけで What / Why が伝わる。マージ後はブランチ削除、main は常にデプロイ可能に保つ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="1140" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>